{
  "schemaVersion": 1,
  "id": "realism_renderer",
  "version": "${version}",
  "name": "Realism Renderer",
  "description": "Sends your world to the Realism Renderer app, which redraws it in real time as a realistic landscape. Requires the Realism Renderer app (Windows).",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.realismrenderer.BridgeMod"],
    "modmenu": ["com.realismrenderer.ModMenuIntegration"]
  },
  "mixins": ["realism_renderer.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.5",
    "fabric-api": "*",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
